# 🍭 Candy Shop - Environment Configuration Example

# --- DATABASE CONFIG ---
# Local Development (SQLite)
# Leave DATABASE_URL empty to use local candy_ecommerce.db
DATABASE_URL=

# Production (Supabase / PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
# Example: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres.youruser:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- AUTH CONFIG ---
JWT_SECRET=super_secret_candy_key_123
NODE_ENV=development

# --- FRONTEND CONFIG ---
# The URL of your deployed frontend (for CORS security)
FRONTEND_URL=https://poject-intern.vercel.app/vi

# --- API URL (Frontend Only) ---
# Used by the frontend to know where the backend is
VITE_API_URL=https://poject-intern.onrender.com

# --- MAIL CONFIG (Gmail SMTP Recommended) ---
# For Gmail: 
# 1. Use 'smtp.gmail.com'
# 2. Use port 587
# 3. Create an 'App Password' in your Google Account Security settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password-16-chars
